{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IOT-CV WebSocket contract",
  "description": "Sinh tu backend/schemas.py. KHONG sua tay file nay — sua schemas.py roi chay: uv run python -m backend.schemas",
  "contract_version": 1,
  "envelope": {
    "$ref": "#/$defs/Envelope"
  },
  "downlink": {
    "telemetry": {
      "$ref": "#/$defs/Telemetry"
    },
    "status": {
      "$ref": "#/$defs/StatusPayload"
    },
    "event": {
      "$ref": "#/$defs/EventPayload"
    },
    "detection": {
      "$ref": "#/$defs/DetectionPayload"
    },
    "ack": {
      "$ref": "#/$defs/AckPayload"
    },
    "error": {
      "$ref": "#/$defs/ErrorPayload"
    },
    "pong": {
      "$ref": "#/$defs/PongPayload"
    }
  },
  "uplink": {
    "ping": {
      "$ref": "#/$defs/CmdPing"
    },
    "cmd.web_control_enable": {
      "$ref": "#/$defs/CmdWebControlEnable"
    },
    "cmd.mode": {
      "$ref": "#/$defs/CmdMode"
    },
    "cmd.arm": {
      "$ref": "#/$defs/CmdArm"
    },
    "cmd.takeoff": {
      "$ref": "#/$defs/CmdTakeoff"
    },
    "cmd.velocity": {
      "$ref": "#/$defs/CmdVelocity"
    },
    "cmd.hold": {
      "$ref": "#/$defs/CmdSimple"
    },
    "cmd.rtl": {
      "$ref": "#/$defs/CmdSimple"
    },
    "cmd.land": {
      "$ref": "#/$defs/CmdSimple"
    },
    "cmd.mission.upload": {
      "$ref": "#/$defs/CmdMissionUpload"
    }
  },
  "rest": {
    "GET /api/status": {
      "$ref": "#/$defs/StatusPayload"
    },
    "GET /api/config": {
      "$ref": "#/$defs/ConfigPayload"
    },
    "GET /api/mission": {
      "$ref": "#/$defs/MissionPayload"
    },
    "POST /api/mission": {
      "$ref": "#/$defs/MissionUploadResult"
    },
    "GET /api/events": {
      "$ref": "#/$defs/EventsPayload"
    },
    "GET /api/telemetry/history": {
      "$ref": "#/$defs/TelemetryHistoryPayload"
    },
    "GET /api/system": {
      "$ref": "#/$defs/SystemPayload"
    },
    "GET /api/recording": {
      "$ref": "#/$defs/RecordingStatus"
    },
    "POST /api/recording/start": {
      "$ref": "#/$defs/RecordingStatus"
    },
    "POST /api/recording/stop": {
      "$ref": "#/$defs/RecordingStatus"
    },
    "GET /api/flights": {
      "$ref": "#/$defs/FlightListPayload"
    },
    "GET /api/flight": {
      "$ref": "#/$defs/FlightDetail"
    },
    "GET /api/flights/ai": {
      "$ref": "#/$defs/FlightFrameAI"
    }
  },
  "uplink_rate_limits": {
    "ping": 2,
    "cmd.web_control_enable": 5,
    "cmd.mode": 5,
    "cmd.arm": 2,
    "cmd.takeoff": 2,
    "cmd.velocity": 30,
    "cmd.hold": 5,
    "cmd.rtl": 5,
    "cmd.land": 5,
    "cmd.mission.upload": 1
  },
  "error_codes": [
    "unknown_type",
    "unsupported_version",
    "bad_payload",
    "not_implemented",
    "not_connected",
    "web_control_disabled",
    "wrong_mode",
    "command_denied",
    "validation_failed",
    "rate_limited",
    "timeout",
    "internal"
  ],
  "$defs": {
    "AckPayload": {
      "description": "`accepted` = backend nhận và thấy hợp lệ. `done` = FC đã xác nhận.\n\nLệnh chậm (mode, arm, takeoff, mission) gửi CẢ HAI. Lệnh nhanh chỉ `done`.\n`cmd.velocity` KHÔNG sinh ack — nó chạy 5-20 Hz, ack sẽ làm ngập socket.",
      "properties": {
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "command": {
          "title": "Command",
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted",
            "done"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "command",
        "status"
      ],
      "title": "AckPayload",
      "type": "object"
    },
    "CameraStatus": {
      "properties": {
        "available": {
          "default": false,
          "title": "Available",
          "type": "boolean"
        },
        "url": {
          "default": "/api/video/stream",
          "title": "Url",
          "type": "string"
        },
        "fake": {
          "default": true,
          "title": "Fake",
          "type": "boolean"
        }
      },
      "title": "CameraStatus",
      "type": "object"
    },
    "CmdArm": {
      "description": "`false` = disarm. CẤM mọi tham số force — xem SAFETY.md mục 1.",
      "properties": {
        "arm": {
          "title": "Arm",
          "type": "boolean"
        }
      },
      "required": [
        "arm"
      ],
      "title": "CmdArm",
      "type": "object"
    },
    "CmdMissionUpload": {
      "description": "Backend KHÔNG tự chèn takeoff/RTL còn thiếu — báo `validation_failed`\nđể người sửa (Phase 07).",
      "properties": {
        "waypoints": {
          "items": {
            "$ref": "#/$defs/MissionWaypoint"
          },
          "title": "Waypoints",
          "type": "array"
        },
        "auto_start": {
          "default": false,
          "title": "Auto Start",
          "type": "boolean"
        }
      },
      "required": [
        "waypoints"
      ],
      "title": "CmdMissionUpload",
      "type": "object"
    },
    "CmdMode": {
      "properties": {
        "mode": {
          "enum": [
            "GUIDED",
            "LOITER",
            "ALT_HOLD",
            "POSHOLD",
            "BRAKE",
            "RTL",
            "LAND",
            "AUTO",
            "STABILIZE"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "CmdMode",
      "type": "object"
    },
    "CmdPing": {
      "properties": {},
      "title": "CmdPing",
      "type": "object"
    },
    "CmdSimple": {
      "description": "Dùng chung cho `cmd.hold`, `cmd.rtl`, `cmd.land` — không có tham số.",
      "properties": {},
      "title": "CmdSimple",
      "type": "object"
    },
    "CmdTakeoff": {
      "description": "Phải nằm trong [MIN_ALT, MAX_ALT]. Vượt thì trả error, KHÔNG im lặng kẹp\n— kiểm ở Phase 06, nơi có config trong tay.",
      "properties": {
        "altitude": {
          "title": "Altitude",
          "type": "number"
        }
      },
      "required": [
        "altitude"
      ],
      "title": "CmdTakeoff",
      "type": "object"
    },
    "CmdVelocity": {
      "description": "m/s, body frame. `vz` DƯƠNG = XUỐNG (quy ước NED, đừng đảo).",
      "properties": {
        "vx": {
          "default": 0.0,
          "title": "Vx",
          "type": "number"
        },
        "vy": {
          "default": 0.0,
          "title": "Vy",
          "type": "number"
        },
        "vz": {
          "default": 0.0,
          "title": "Vz",
          "type": "number"
        },
        "yaw_rate": {
          "default": 0.0,
          "title": "Yaw Rate",
          "type": "number"
        }
      },
      "title": "CmdVelocity",
      "type": "object"
    },
    "CmdWebControlEnable": {
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "CmdWebControlEnable",
      "type": "object"
    },
    "ConfigPayload": {
      "description": "`GET /api/config` — UI đọc ngưỡng từ đây, không hardcode.",
      "properties": {
        "limits": {
          "$ref": "#/$defs/LimitsPayload"
        },
        "endpoint": {
          "title": "Endpoint",
          "type": "string"
        },
        "telemetry_hz": {
          "title": "Telemetry Hz",
          "type": "number"
        },
        "versions": {
          "$ref": "#/$defs/VersionsPayload"
        }
      },
      "required": [
        "limits",
        "endpoint",
        "telemetry_hz",
        "versions"
      ],
      "title": "ConfigPayload",
      "type": "object"
    },
    "DetectionBox": {
      "description": "Toạ độ là PIXEL trong hệ của khung gốc (width×height) — không phải tỉ lệ\n0-1, không phải pixel màn hình. Frontend tự quy đổi.",
      "properties": {
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        },
        "x2": {
          "title": "X2",
          "type": "number"
        },
        "y2": {
          "title": "Y2",
          "type": "number"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2",
        "confidence",
        "label"
      ],
      "title": "DetectionBox",
      "type": "object"
    },
    "DetectionPayload": {
      "properties": {
        "frame_id": {
          "title": "Frame Id",
          "type": "integer"
        },
        "frame_ts": {
          "title": "Frame Ts",
          "type": "number"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "boxes": {
          "items": {
            "$ref": "#/$defs/DetectionBox"
          },
          "title": "Boxes",
          "type": "array"
        }
      },
      "required": [
        "frame_id",
        "frame_ts",
        "width",
        "height"
      ],
      "title": "DetectionPayload",
      "type": "object"
    },
    "Envelope": {
      "description": "Lớp bọc chung cho MỌI message, cả hai chiều.\n\n`data` để kiểu dict chứ không phải union phân biệt theo `type`. Cố ý:\nunion sẽ gộp \"type không tồn tại\" và \"data sai kiểu\" thành cùng một lỗi\nvalidation, trong khi hợp đồng đòi hai mã lỗi KHÁC nhau (`unknown_type` vs\n`bad_payload`). Nên việc kiểm `data` được tách thành bước hai, tra bảng\n`UPLINK_MODELS` — xem `backend/ws.py`.",
      "properties": {
        "v": {
          "title": "V",
          "type": "integer"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "ts": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ts"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "v",
        "type"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "ErrorPayload": {
      "properties": {
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorPayload",
      "type": "object"
    },
    "EventPayload": {
      "description": "`code` là khoá máy đọc (UI lọc và tô màu theo nó).\n`message` là tiếng Việt cho người đọc.",
      "properties": {
        "level": {
          "default": "info",
          "enum": [
            "info",
            "warn",
            "error"
          ],
          "title": "Level",
          "type": "string"
        },
        "source": {
          "default": "backend",
          "enum": [
            "mavlink",
            "safety",
            "mission",
            "vision",
            "backend"
          ],
          "title": "Source",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "ts": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ts"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "EventPayload",
      "type": "object"
    },
    "EventsPayload": {
      "description": "`GET /api/events` — lịch sử từ EventBus, cũ trước mới sau.",
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/EventPayload"
          },
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "events"
      ],
      "title": "EventsPayload",
      "type": "object"
    },
    "FlightDetail": {
      "description": "`GET /api/flight?id=…` — đủ để phát lại một chuyến.",
      "properties": {
        "summary": {
          "$ref": "#/$defs/FlightSummary"
        },
        "window_start": {
          "title": "Window Start",
          "type": "number"
        },
        "window_end": {
          "title": "Window End",
          "type": "number"
        },
        "home": {
          "anyOf": [
            {
              "$ref": "#/$defs/FlightPoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "series": {
          "$ref": "#/$defs/FlightSeries"
        },
        "column_sources": {
          "additionalProperties": {
            "enum": [
              "dataflash",
              "tlog"
            ],
            "type": "string"
          },
          "title": "Column Sources",
          "type": "object"
        },
        "modes": {
          "items": {
            "$ref": "#/$defs/FlightModeSpan"
          },
          "title": "Modes",
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/FlightEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "video": {
          "items": {
            "$ref": "#/$defs/FlightVideoClip"
          },
          "title": "Video",
          "type": "array"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "clock_offset_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clock Offset S"
        },
        "clock_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clock Note"
        }
      },
      "required": [
        "summary",
        "window_start",
        "window_end",
        "series",
        "column_sources",
        "modes",
        "events",
        "video",
        "files"
      ],
      "title": "FlightDetail",
      "type": "object"
    },
    "FlightEvent": {
      "properties": {
        "t": {
          "title": "T",
          "type": "number"
        },
        "level": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Level",
          "type": "string"
        },
        "source": {
          "enum": [
            "fc",
            "link",
            "camera",
            "arm"
          ],
          "title": "Source",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "t",
        "level",
        "source",
        "text"
      ],
      "title": "FlightEvent",
      "type": "object"
    },
    "FlightFrameAI": {
      "description": "`GET /api/flights/ai?rec=…&n=…` — AI trên MỘT khung đã ghi (trang Lịch sử bay).\n\n`boxes` là hộp người của detector chạy trên khung GỐC (D5), toạ độ pixel của khung\n`width×height`. Ảnh rõ của khung lấy ở `/api/flights/frame?…&variant=enhanced`; trường\n`enhancer` cho biết có lấy được không. `note` = lý do riêng của khung này (vd. sai cỡ).\n`quality_enhanced` / `enhancer_ms` chỉ có khi enhancer chạy được trên khung này.",
      "properties": {
        "rec": {
          "title": "Rec",
          "type": "string"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "detector": {
          "$ref": "#/$defs/VisionModelStatus"
        },
        "enhancer": {
          "$ref": "#/$defs/VisionModelStatus"
        },
        "boxes": {
          "items": {
            "$ref": "#/$defs/DetectionBox"
          },
          "title": "Boxes",
          "type": "array"
        },
        "detector_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detector Ms"
        },
        "enhancer_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enhancer Ms"
        },
        "quality_raw": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageQuality"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quality_enhanced": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageQuality"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "rec",
        "n",
        "width",
        "height",
        "detector",
        "enhancer",
        "boxes"
      ],
      "title": "FlightFrameAI",
      "type": "object"
    },
    "FlightListPayload": {
      "description": "`GET /api/flights` — mọi chuyến, cũ trước mới sau.",
      "properties": {
        "flights": {
          "items": {
            "$ref": "#/$defs/FlightSummary"
          },
          "title": "Flights",
          "type": "array"
        },
        "skipped": {
          "items": {
            "$ref": "#/$defs/FlightSkippedFile"
          },
          "title": "Skipped",
          "type": "array"
        }
      },
      "required": [
        "flights",
        "skipped"
      ],
      "title": "FlightListPayload",
      "type": "object"
    },
    "FlightModeSpan": {
      "properties": {
        "t0": {
          "title": "T0",
          "type": "number"
        },
        "t1": {
          "title": "T1",
          "type": "number"
        },
        "mode": {
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "t0",
        "t1",
        "mode"
      ],
      "title": "FlightModeSpan",
      "type": "object"
    },
    "FlightPoint": {
      "properties": {
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "FlightPoint",
      "type": "object"
    },
    "FlightSeries": {
      "description": "Chuỗi số liệu trên một lưới thời gian chung. `t` tính bằng giây từ `window_start`;\nmọi cột dài bằng `t`, `None` = không có dữ liệu lúc đó (khác 0).",
      "properties": {
        "t": {
          "items": {
            "type": "number"
          },
          "title": "T",
          "type": "array"
        },
        "lat": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Lat",
          "type": "array"
        },
        "lon": {
          "items": {
