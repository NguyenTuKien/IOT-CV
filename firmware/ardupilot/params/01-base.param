# 01-base.param - cau hinh nen truoc chuyen bay dau
# Board: SpeedyBee F405 V5 | ArduCopter 4.7.1 CUSTOM BUILD (custom.ardupilot.org)
# Nap SAU khi 00-after-flash.param da luu.
# Cach load: Mission Planner -> Config/Tuning -> Full Parameter List
#            -> Load from file -> Write Params -> reboot FC
#
# CHUA bao gom: obstacle avoidance (xem 02-avoid-tfmini.param)
#               radio calibration, compass calibration, ESC calibration
#               -> ba thu do PHAI lam bang wizard, khong nap bang file param.
#
# Nguon: ban nhap plans/reports/260921-research-sitl-firmware-toolchain.md muc 4.6.
# Sua co chu y so voi ban nhap (ly do ghi ngay tai dong do):
#   SERIAL2_BAUD 57 -> 115, BATT_CAPACITY 5000 -> 5300, BATT_LOW_MAH 1000 -> 1060,
#   BO dong SERIAL5_BAUD (firmware ep cung 115200, xem muc motor/ESC ben duoi).
# Da nap thu vao SITL o Phase 11.7 - ket qua: firmware/ardupilot/build-d450a747/NOTES.md

# ---------- khung ----------
# FRAME_CLASS 1 = Quad, FRAME_TYPE 12 = X kieu Betaflight  (khung S500)
# Sua 12/10/2026, truoc la 1 (X chuan ArduPilot). ESC OX32 danh so motor kieu
# Betaflight: M1 sau-phai, M2 truoc-phai, M3 sau-trai, M4 truoc-trai (so do chinh
# hang assignment/_build/img/official/speedybee/v5_25.jpg va v5_26.jpg), va hwdef
# speedybeef4v5 cua ArduPilot dat mac dinh 12 vi dung ly do do.
# Chieu quay theo VI TRI giong het X chuan: truoc-phai + sau-trai CCW,
# truoc-trai + sau-phai CW. VAN PHAI kiem chung bang Motor Test o Phase 16.
#
# Sua 01/11/2026 cho KHOP FC THAT: tren bo dang chay FRAME_TYPE 1 (X chuan) + doi
# thu tu dau ra SERVO1..4_FUNCTION = 36/33/34/35 (Motor4/1/2/3). Hai cach TUONG
# DUONG: dau ra 1..4 van la sau-phai / truoc-phai / sau-trai / truoc-trai, dung
# chieu quay - Motor Test 27/10/2026: A->SERVO2 truoc-phai, B->SERVO1 sau-phai,
# C->SERVO3 sau-trai, D->SERVO4 truoc-trai. TRUOC DAY file ghi FRAME_TYPE 12 ma
# khong co 4 dong SERVO: nap file do len FC dang co 36/33/34/35 la SAI THU TU MOTOR.
# SITL van dung mo hinh "-f bfx" (cung vi tri dau ra).
FRAME_CLASS,1
FRAME_TYPE,1
SERVO1_FUNCTION,36
SERVO2_FUNCTION,33
SERVO3_FUNCTION,34
SERVO4_FUNCTION,35

# ---------- cong serial ----------
# SERIAL1 = module Bluetooth noi bo, ArduPilot KHONG dung duoc -> de None
SERIAL1_PROTOCOL,-1

# SERIAL2 = ESP32 DroneBridge (Phase 17). UART2 la cong duy nhat co DMA.
# 2 = MAVLink2, baud 115 = 115200 (mac dinh cua DroneBridge).
# Ban nhap ghi "57 (hoac 115)" - day la cho chot, khong phai sua sai.
SERIAL2_PROTOCOL,2
SERIAL2_BAUD,115

# SERIAL3 = TFmini Plus (nap tu 02-avoid-tfmini.param, ghi lai o day de doi chieu)
# Mac dinh cua board la MSP DisplayPort nhung ban custom build da TAT OSD/MSP.
SERIAL3_PROTOCOL,9
SERIAL3_BAUD,115

# SERIAL4 = GPS Holybro M10 (u-blox). 5 = GPS, baud 230 = 230400 (mac dinh board)
SERIAL4_PROTOCOL,5
SERIAL4_BAUD,230

# SERIAL5 = ESC telemetry (OX32 4in1). 16 = ESC Telemetry.
# KHONG dat SERIAL5_BAUD: ban nhap ghi "19 = mac dinh board" la SAI.
# AP_SerialManager ep cung 115200 cho moi cong co PROTOCOL 16 luc khoi dong,
# nap 19 thi FC nhan roi sau reboot doc lai 115 (do that tren SITL, Phase 04).
# Dong do vo tac dung ca tren board that, nen bo.
SERIAL5_PROTOCOL,16

# SERIAL6 = receiver FlySky iA6B qua iBUS tren chan R6. 23 = RCIN
SERIAL6_PROTOCOL,23

# ---------- receiver ----------
# RC_PROTOCOLS la BITMASK. bit2 = IBUS -> gia tri 4.
# Chi bat iBUS (thay vi 1 = All) de tranh nhan nham protocol.
# Tren SITL gia tri nay lam "PreArm: RC not found" vi RC ao di qua bit18
# (SITL UDP). Chi SITL moi can 262148 - KHONG dat so do len board that.
RC_PROTOCOLS,4

# ---------- GPS ----------
# Ten param doi tu GPS_TYPE -> GPS1_TYPE tu ban 4.6 tro di.
# 2 = uBlox (M10 la u-blox; firmware custom da BO driver NMEA)
GPS1_TYPE,2

# ---------- compass ----------
# Board KHONG co compass tich hop. M10 mang IST8310 tren I2C.
# ArduPilot tu do driver -> khong ep bang param.
# PHAI chay Onboard Mag Calibration SAU khi lap len khung (Phase 19).
COMPASS_ENABLE,1
COMPASS_USE,1

# ---------- motor / ESC ----------
# 5 = DShot300. Bat dau bang 300 (dung sai nhieu tot hon 600).
# Nang len 6 = DShot600 SAU khi da bay on, neu muon.
MOT_PWM_TYPE,5
# So cuc nam cham cua motor. 14 la mac dinh, dung cho HAU HET motor 2212/2216.
# KIEM TRA datasheet motor thuc te; sai so nay -> RPM telemetry sai.
# SITL bao "khong ton tai" cho hai dong SERVO_BLH_* (SITL khong build BLHeli);
# board ChibiOS thi CO. Xem NOTES.md cua ban build.
SERVO_BLH_POLES,14
# 10Hz du cho hien thi; nang len 100 khi bat harmonic notch theo RPM (Phase 22).
SERVO_BLH_TRATE,10
# Sua 25/10/2026, truoc la 0.10 (mac dinh). Pin 4S + canh T1045: ESC OX32 khoi dong
# hut ngay sau khi arm (vong quay vot len roi tut ve ~0 = tieng "khac"), M1 sau-phai
# nang nhat. Do 25/10 (logs/fc-dataflash-20261025-bay-trong-nha/005 va
# logs/fc-dataflash-20261025-spin-arm-013/006): lan motor tut <300 RPM trong 3 s dau
# 13/32 lan khoi dong o 0.10 -> 2/28 o 0.13; M1 bat vong TB 0.43 s (max 0.99) -> 0.31 s
# (max 0.39). Phai <= MOT_SPIN_MIN (0.15). Cai dat ESC cung da doi: firmware/esc-ox32/.
# Da thu 0.15 cung ngay (logs/fc-dataflash-20261025-spin-arm-015/007): 6/32 lan hut,
# M1 TB 0.40 s (max 0.69) -> KHONG tot hon 0.13, nen giu 0.13.
MOT_SPIN_ARM,0.13
# Them 02/11/2026: chan cat canh khi co motor chua quay. Log bay ngoai troi 01/11
# (logs/fc-dataflash-20261101-bay-ngoai-troi/001): M1 (sau-phai) loi o 4/5 lan khoi
# dong - hut o chuyen 1, 3, 4; chuyen 5 (20:28) M1 dung 0 vong suot 2,6 s trong khi 3
# motor kia da quay ~1900 vong (tieng "khac khac"). 25/10 trong nha chi 2/28 lan. Keo
# ga luc M1 chua quay la drone lat ve phia M1 ngay khi roi dat.
# FC giu motor o vong cho (MOT_SPIN_ARM) toi khi CA 4 ESC bao 1000..4000 vong, web
# bao "Takeoff blocked: ESC RPM out of range" moi 2 s. Vong cho do duoc 1850-1960 o
# 15,5 V; 4000 chan so rac telemetry (01/11 co mau 44162). Can ESC telemetry SERIAL5.
TKOFF_RPM_MIN,1000
TKOFF_RPM_MAX,4000

# ---------- pin 4S ----------
# 4 = Analog Voltage and Current (mac dinh cua board)
BATT_MONITOR,4
# CANH BAO dien ap: README board ghi VOLT_MULT 11.2, hwdef.dat ghi 11.0.
#           Hai nguon MAU THUAN. Dat theo hwdef (thu duoc bien dich vao firmware)
#           roi PHAI hieu chinh bang dong ho van nang o Phase 16:
#           Mission Planner -> Setup -> Optional Hardware -> Battery Monitor
#           -> go dien ap do duoc vao o "Measured battery voltage".
BATT_VOLT_MULT,11.0
# Dong dien: sua 12/10/2026, truoc la 25.0 (hwdef) - con so do khong khop ESC nay.
#   Trang thong so SpeedyBee F405 V5 OX32 55A ghi "Scale=27, Offset=-2644"
#   (don vi Betaflight: mV moi 10A va mA). Quy sang ArduPilot:
#   AMP_PERVLT = 10000/27 = 370.4 A/V ; AMP_OFFSET = 2.644/370.4 = 0.0071 V.
#   De 25 thi dong doc thap ~15 lan -> mAh da dung sai -> failsafe theo mAh
#   (BATT_LOW_MAH) gan nhu khong bao gio kich hoat.
#   Van PHAI hieu chinh lai theo mAh sac tra (Phase 19.9 / Phase 20.4).
BATT_AMP_PERVLT,370.4
BATT_AMP_OFFSET,0.0071
# Dien dung THUC TE cua pin: Ovonic 4S 5300mAh (ban nhap ghi 5000, "doi theo pin ban mua")
BATT_CAPACITY,5300
# Nguong 4S: 3.5V/cell = 14.0V (canh bao), 3.3V/cell = 13.2V (nguy hiem).
# Bao thu cho pin moi; siet lai sau khi biet sut ap thuc te.
BATT_LOW_VOLT,14.0
BATT_CRT_VOLT,13.2
# 20% cua 5300 - chua 20% cho tuoi tho pin
BATT_LOW_MAH,1060
# Them 02/11/2026: bu dien ap pin cho bo dieu khien (4S: 4,2 V va 3,3 V moi cell).
# Tat (0) thi pin tut 15,5 -> 14,8 V (do 01/11) la cung muc ga cho luc day khac,
# do nhay dieu khien doi theo pin.
MOT_BAT_VOLT_MAX,16.8
MOT_BAT_VOLT_MIN,13.2
BATT_FS_LOW_ACT,2
BATT_FS_CRT_ACT,1
# Bo qua kiem tra dien ap pin luc khoi dong o lan dau tien de tranh
# bao loi nham khi chua hieu chinh xong. DAT LAI 0 sau khi calib xong (Phase 16).
BATT_ARM_VOLT,0

# ---------- failsafe co ban ----------
# 1 = mat song tay cam -> RTL. 25-27/10/2026 bay trong nha da TAM doi 3 (Land) va
# BATT_FS_LOW_ACT 1 (Land); 01/11/2026 tra ve 1 / 2 de bay ngoai troi (doc lai PASS).
FS_THR_ENABLE,1
FS_EKF_ACTION,1
# Wi-Fi 2.4GHz SE rot lat vat. De 1 (RTL) thi drone tu bay ve chi vi laptop
# mat goi 5 giay. Cac chuyen dau de 0 va dua vao RC failsafe - bo RC moi la
# duong day cuu sinh, khong phai Wi-Fi.
FS_GCS_ENABLE,0

# ---------- toc do + RTL (bay ngoai troi, nguoi dung chon 01/11/2026) ----------
# Don vi m va m/s (ban 4.7 doi ten: WPNAV_SPEED cm/s -> WP_SPD m/s, RTL_ALT cm ->
# RTL_ALT_M m). Mac dinh 12.5 m/s (Loiter) / 10 m/s (mission) qua nhanh voi nguoi
# moi; nguoi dung chon 3 m/s cho ca hai. RTL bay ve cung toc do WP_SPD.
# RTL_ALT_M 15: thap hon tran fence 20 m - margin 2 (02-avoid-tfmini.param); FC
# tu ha RTL xuong duoi tran fence neu dat cao hon.
LOIT_SPEED_MS,3
WP_SPD,3
RTL_ALT_M,15

# ---------- log ----------
# Board co 16MB dataflash.
# Sua 25/10/2026, truoc la 1 (ghi ca luc chua arm): 1 lam day 16MB trong mot buoi
# va FC tu xoa log cu (mat mot log 7,8MB). 0 = chi ghi luc dang ARM. Moi lan FC khoi
# dong la MOT log, cac lan ARM sau ghi noi vao log do (log ngay 01/11/2026 chua 5 chuyen).
# Do 01/11/2026: ~17 KB/s khi ARM -> 16MB chua ~15 phut bay; log cu nhat bi xoa dan tu
# dau (mat bang FMT, doc bang scripts/fc/phan_tich_log.py --fmt-tu). Tai log ve sau
# moi buoi bay, va ngay sau moi lan roi / mat lai: scripts/fc/tai_log.py.
LOG_BITMASK,176126
LOG_DISARMED,0
# Them 02/11/2026: moi lan DISARM dong log, lan ARM sau mo log moi -> moi chuyen mot
# file co bang FMT rieng; chip day thi chi chuyen cu nhat bi xoa, khong con mat dau
# ca mot log 5 chuyen.
LOG_FILE_DSRMROT,1
# Them 02/11/2026: 1 = chi ghi XKF4 (ty so innovation, co loi FS) cua EKF3, bo XKF1-3,
# XKF5, XKY0/1, XKQ, XKV: bot ~3,7 trong ~17 KB/s -> 16MB chua ~20 phut bay thay
# vi ~15. Vi tri / tu the van co o POS, ATT, CTUN, PSCN/E/D. Can soi EKF ky thi tam
# dat lai 0.
EK3_LOG_LEVEL,1
