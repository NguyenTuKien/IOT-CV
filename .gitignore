# ---------------------------------------------------------------------------
# ArduPilot source (dùng làm công cụ SITL, KHÔNG phải code của dự án)
# Clone vào ~/ardupilot TRONG WSL, xem plans/phase-02-wsl2-sitl.md việc 02.2.
# Dòng dưới là bảo hiểm phòng ai lỡ clone vào trong repo — giữ lại, đừng xoá.
# ---------------------------------------------------------------------------
/ardupilot/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv-*/
venv/
venv-*/
env/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Secrets / cấu hình cục bộ
# ---------------------------------------------------------------------------
.env
.env.local
*.local.yml

# ---------------------------------------------------------------------------
# Machine learning: dataset và weights KHÔNG commit (dung lượng lớn).
# Giữ lại cấu trúc thư mục bằng .gitkeep.
# ---------------------------------------------------------------------------
ml/datasets/*
!ml/datasets/.gitkeep
# DVC (AI Phase 1, A1.8) phien ban-hoa ml/datasets/ bang con tro .dvc. Dong
# "ml/datasets/*" o tren loai ca con tro lan file .gitignore rieng cua DVC, nen
# phai mo lai hai thu do — chung la METADATA, khong phai du lieu.
!ml/datasets/*.dvc
!ml/datasets/.gitignore
ml/weights/*
!ml/weights/.gitkeep
ml/results/*
!ml/results/.gitkeep
runs/
*.pt
*.onnx
*.engine

# ---------------------------------------------------------------------------
# Flight log / telemetry / ảnh detection
# Giữ lại cấu trúc thư mục nhưng không commit dữ liệu bay.
# ---------------------------------------------------------------------------
logs/.cache/
detections/
snapshots/

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
node_modules/

# ---------------------------------------------------------------------------
# ESP32 / PlatformIO / Arduino build
# ---------------------------------------------------------------------------
.pio/
esp32/**/build/

# ---------------------------------------------------------------------------
# IDE / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
# .claude: chỉ phần dự án IOT-CV dùng; kit TheOneKit (hooks/skills/modules...) KHÔNG đẩy.
.claude/*
!.claude/rules/
.claude/rules/*
!.claude/rules/code-conventions-web.md
!.claude/rules/computer-use-cua-driver-first.md
!.claude/rules/orchestration-protocol.md
!.claude/rules/skill-domain-routing-web.md
!.claude/rules/skill-domain-routing.md
!.claude/iot-cv-hooks.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/iot-cv-*
!.claude/skills/
.claude/skills/*
!.claude/skills/iot-cv-*
# Mật khẩu Wi-Fi của hotspot (camera-secrets.ps1 sinh ra) và .env: KHÔNG BAO GIỜ commit
firmware/camera/include/secrets.h
# frontend/dist do backend phục vụ, build ra từ frontend/ nhưng giữ lại theo yêu cầu
!frontend/dist/
.codex
.agents
.playwright-mcp
tmp

# ---------------------------------------------------------------------------
# Firmware ArduPilot: nhi phan tai ve / build ra -> KHONG commit.
# Tai lai bat cu luc nao tu custom.ardupilot.org bang dung file
# firmware/ardupilot/custombuild/*.yaml
# ---------------------------------------------------------------------------
copter-speedybeef4v5-d450a747.tar.gz
# .bin cua build-*/ da bi dong "*.bin" chung o muc Flight log chan san.
# Phase 11.1: firmware DroneBridge tai ve cho ESP32 (Phase 17) cung la nhi phan.

# build.log cua custom build PHAI duoc commit: no la bang chung feature da build
# dung y (PRX_*, OAPATHPLANNER, TFMINIPLUS...). Dong "!" nay PHAI nam SAU dong
# "*.log" o phia tren, neu khong git van bo qua file.

# Bài tập môn học, không thuộc dự án
assignment/
