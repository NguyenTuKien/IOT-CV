# Non-secret production settings. Actual values are generated on the server.
# Use immutable registry digests produced by the workflow, not latest tags.
ENVIRONMENT=demo
PUBLIC_HOSTNAME=uav.ngtukien.id.vn
IOTCV_IMAGE=ghcr.io/ngtukien/iot-cv@sha256:REPLACE_WITH_IMAGE_DIGEST
CLOUDFLARED_IMAGE=ghcr.io/ngtukien/iot-cv-tunnel@sha256:REPLACE_WITH_IMAGE_DIGEST
IOTCV_DATA_DIR=/srv/iotcv/data
CLOUDFLARED_TOKEN_FILE=/etc/iotcv/secrets/tunnel_token

# Cloudflare Tunnel token comes ONLY from the GitHub Actions secret
# CLOUDFLARE_TUNNEL_TOKEN through the deployment step's environment.
# Never place the token in this file, application env, build args or Terraform.

# Safe demo; existing flight limits are inherited from backend/config.py.
TELEMETRY_AUTOSTART=0
MAVLINK_ENDPOINT=
CAMERA_FAKE=1
VISION_ENABLED=1
RECORD_VIDEO=0
